#!/command/with-contenv sh
# ==============================================================================
# Take the add-on down when the proxy stops
# ==============================================================================
# 256 means the service was killed by a signal, which is a normal add-on stop.
if [ "${1}" -ne 0 ] && [ "${1}" -ne 256 ]; then
    echo "wake-proxy exited with code ${1}"
fi

exec /run/s6/basedir/bin/halt
