#!/usr/bin/env python3
"""Liveness probe for the Docker HEALTHCHECK.

The port is read where the proxy itself reads it, so the check cannot drift
apart from the listen_port setting.
"""
import json
import os
import sys
import urllib.request

port = os.environ.get("LISTEN_PORT")
if not port:
    try:
        with open(os.environ.get("WAKE_PROXY_OPTIONS", "/data/options.json")) as f:
            port = json.load(f).get("listen_port")
    except (OSError, ValueError):
        port = None
port = port or 11435

try:
    with urllib.request.urlopen(
        f"http://127.0.0.1:{port}/wake-proxy/health", timeout=5
    ) as r:
        sys.exit(0 if r.status == 200 else 1)
except Exception as err:  # noqa: BLE001 - any failure means "not alive"
    print(f"wake-proxy-health: {err}")
    sys.exit(1)
