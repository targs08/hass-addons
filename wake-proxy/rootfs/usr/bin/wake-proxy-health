#!/usr/bin/env python3
"""Проверка живости для Docker HEALTHCHECK.

Порт берётся там же, где его берёт сам прокси, чтобы проверка не разошлась с
настройкой listen_port.
"""
import json
import os
import sys
import urllib.request

port = os.environ.get("LISTEN_PORT")
if not port:
    try:
        with open(os.environ.get("WAKE_PROXY_OPTIONS", "/data/options.json")) as f:
            port = json.load(f).get("listen_port")
    except (OSError, ValueError):
        port = None
port = port or 11435

try:
    with urllib.request.urlopen(
        f"http://127.0.0.1:{port}/wake-proxy/health", timeout=5
    ) as r:
        sys.exit(0 if r.status == 200 else 1)
except Exception as err:  # noqa: BLE001 - любая ошибка означает "не живой"
    print(f"wake-proxy-health: {err}")
    sys.exit(1)
